# Release settings for `npm run package`, which writes them into the Chrome Web Store zip. Every value is public.
# Local development doesn't read this file: the unpacked extension uses config.js.
# Copy this file to .env.local and fill it in; variables already set in the environment win.

# HTTPS origins, with no path: the API, the web app, and the Clerk Frontend API (the API's CLERK_ISSUER).
API_BASE_URL=
APP_BASE_URL=
CLERK_SYNC_HOST=
# The live Clerk publishable key (pk_live_…). Never a secret key.
CLERK_PUBLISHABLE_KEY=
# The store item's public key (Developer Dashboard > Package), so the zip updates the existing listing.
CHROME_WEB_STORE_PUBLIC_KEY=
