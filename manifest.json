{
  "manifest_version": 3,
  "name": "QA Ninja: Your Silent QA Architect",
  "description": "Find and test XPath free for 50 inspections a day. Paid plans record workflows and run them as tests with AI agents in your own Chrome.",
  "version": "2.1.0",
  "icons": {
    "16": "icons/icon16-light.png",
    "48": "icons/icon48-light.png",
    "128": "icons/icon128-light.png"
  },
  "action": {
    "default_title": "Open QA Ninja Panel",
    "default_icon": {
      "16": "icons/icon16-light.png",
      "48": "icons/icon48-light.png",
      "128": "icons/icon128-light.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "webNavigation",
    "unlimitedStorage",
    "clipboardWrite",
    "cookies",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "xpath.js",
        "dom.js",
        "inspector.js",
        "snapshot.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "minimum_chrome_version": "125",
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "key": ""
}
